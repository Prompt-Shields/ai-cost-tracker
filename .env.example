# Copy to .env for running outside Docker (`uv run ...`). Every setting is read from an
# ACT_* environment variable; see src/ai_cost_tracker/config.py. docker-compose.yml sets its
# own values for the containers, so .env is not needed there.
# List and dict settings are JSON.

# --- Storage ---------------------------------------------------------------------------
# Async SQLAlchemy URL. Default matches the `db` service in docker-compose.yml.
ACT_DATABASE_URL=postgresql+asyncpg://act:act_local_dev@localhost:5432/ai_cost_tracker
# Redis for the arq job queue.
ACT_REDIS_URL=redis://localhost:6379/0

# --- Sign-in (Entra ID) ----------------------------------------------------------------
# Directory (tenant) ID and application (client) ID of the app registration whose access
# tokens the API accepts. See docs/entra-setup.md.
ACT_ENTRA_TENANT_ID=
ACT_ENTRA_CLIENT_ID=
# Only members of these Entra group object IDs may sign in. Empty = anyone in the tenant.
ACT_ALLOWED_GROUP_IDS=[]
# Entra group object IDs per app role (owner, admin, analyst, viewer). A user gets every
# role whose group they are in. Example: {"owner": ["<group-id>"], "viewer": ["<group-id>"]}
ACT_ROLE_GROUPS={}
# Local development only: skip token validation and act as a fixed dev user with the owner
# role. Refused unless ACT_ENVIRONMENT=local.
ACT_AUTH_DISABLED=true
# local | test | production
ACT_ENVIRONMENT=local

# Browser origins allowed to call the API (JSON list). Defaults to http://localhost:3000
# when ACT_ENVIRONMENT=local.
# ACT_WEB_ORIGINS=["https://costs.example.com"]

# --- Ingestion -------------------------------------------------------------------------
# Which connector the worker runs: "fake" replays deterministic demo data, "azure" reads
# Cost Management, Azure Monitor and Resource Graph with managed identity / az login.
ACT_CONNECTOR=fake
# Subscriptions to track with the Azure connector, as JSON. Empty = every visible
# subscription that contains AI resources. Example: ["00000000-0000-0000-0000-000000000000"]
ACT_AZURE_SUBSCRIPTION_IDS=[]
# Object (principal) ID of the app's managed identity: the identity that "Connect Azure"
# grants Reader to on each subscription. infra/ outputs it.
ACT_AZURE_PRINCIPAL_ID=
# Public URL of the web app, used for the shareable "grant access" link.
ACT_WEB_BASE_URL=http://localhost:3000

# --- GCP (Vertex AI) -------------------------------------------------------------------
# Turn on the GCP connector next to Azure. The fake connector (ACT_CONNECTOR=fake) always
# includes a demo GCP project, so this is only for real projects. Setup: docs/gcp-setup.md.
ACT_GCP_ENABLED=false
# Projects to track, as JSON. Empty = every visible project that uses Vertex AI.
ACT_GCP_PROJECT_IDS=[]
# Workload Identity Federation provider that trusts our Entra tenant (no JSON keys), and the
# service account it impersonates.
ACT_GCP_WIF_AUDIENCE=
ACT_GCP_SERVICE_ACCOUNT=
ACT_GCP_AZURE_TOKEN_SCOPE=api://AzureADTokenExchange/.default
# Detailed usage cost export: <project>.<dataset>.gcp_billing_export_resource_v1_<id>
ACT_GCP_BILLING_EXPORT_TABLE=
ACT_GCP_BILLING_EXPORT_LOCATION=US
# Vertex AI regions to list endpoints in, as JSON.
ACT_GCP_REGIONS=["global", "us-central1", "us-east4", "europe-west4"]

# --- AWS (Bedrock) ----------------------------------------------------------------------
# Turn on the AWS connector. The fake connector always includes a demo AWS account, so this
# is only for real accounts. No access keys: setup in docs/aws-setup.md.
ACT_AWS_ENABLED=false
# Accounts to track, as JSON. Empty = every organization account using Bedrock.
ACT_AWS_ACCOUNT_IDS=[]
ACT_AWS_ROLE_NAME=AiCostTrackerReadOnly
ACT_AWS_AZURE_TOKEN_SCOPE=api://AzureADTokenExchange/.default
ACT_AWS_REGIONS=["us-east-1", "us-west-2", "eu-central-1"]
# CUR 2.0 Data Export location (usually the management account).
ACT_AWS_EXPORT_ACCOUNT_ID=
ACT_AWS_EXPORT_BUCKET=
ACT_AWS_EXPORT_PREFIX=ai-cost-tracker
ACT_AWS_EXPORT_NAME=ai-cost-tracker-cur2
ACT_AWS_EXPORT_REGION=us-east-1
# Optional public S3 URL of infra/aws/readonly-role.yaml for a one-click quick-create link.
ACT_AWS_CFN_TEMPLATE_URL=

# --- Reporting -------------------------------------------------------------------------
# Every total is shown in this currency; other billing currencies use the daily ECB rate.
ACT_REPORTING_CURRENCY=USD

# --- Tenancy ---------------------------------------------------------------------------
# Slug of the single internal tenant every row belongs to in v1 (ARCHITECTURE.md §2a).
ACT_DEFAULT_TENANT_SLUG=internal

# --- Notifications (email) ----------------------------------------------------------------
# Leave ACT_SMTP_HOST empty to disable email channels. Set the password from the environment
# or a Key Vault reference, never in a committed file.
ACT_SMTP_HOST=
ACT_SMTP_PORT=587
ACT_SMTP_USERNAME=
ACT_SMTP_PASSWORD=
ACT_SMTP_FROM=ai-cost-tracker@localhost
ACT_SMTP_STARTTLS=true

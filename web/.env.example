# Copy to .env.local for `npm run dev`. All values are inlined at build time.

# Base URL of the FastAPI backend (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# "true" skips Entra sign-in and calls the API without a token.
# Only works against an API running with ACT_AUTH_DISABLED=true and ACT_ENVIRONMENT=local.
NEXT_PUBLIC_AUTH_DISABLED=true

# Entra ID app registration (single-page application platform, redirect URI = this app's origin).
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=

# Scope exposed by the API app registration, e.g. api://<api-client-id>/access_as_user
NEXT_PUBLIC_API_SCOPE=

// Example parameters. Holds placeholders only: real values come from environment variables
// that the deploy workflow fills from GitHub environment variables (not secrets: none of
// these are sensitive). Never put a password, key or connection string here; the Postgres
// password is generated by the workflow and stored in Key Vault.
//
// Local what-if, after `az login`:
//   ACT_NAME_PREFIX=act ACT_IMAGE_TAG=<sha> ... \
//   az deployment group what-if -g <rg> --parameters infra/main.bicepparam
using 'main.bicep'

param namePrefix = readEnvironmentVariable('ACT_NAME_PREFIX', 'act')
param entraTenantId = readEnvironmentVariable('ACT_ENTRA_TENANT_ID', '00000000-0000-0000-0000-000000000000')
param entraClientId = readEnvironmentVariable('ACT_ENTRA_CLIENT_ID', '00000000-0000-0000-0000-000000000000')
// JSON, e.g. ["<group-object-id>"]
param allowedGroupIds = json(readEnvironmentVariable('ACT_ALLOWED_GROUP_IDS', '[]'))
// JSON, e.g. {"owner": ["<group-object-id>"], "viewer": ["<group-object-id>"]}
param roleGroups = json(readEnvironmentVariable('ACT_ROLE_GROUPS', '{}'))
param azureSubscriptionIds = json(readEnvironmentVariable('ACT_AZURE_SUBSCRIPTION_IDS', '[]'))
param allowedIpRanges = json(readEnvironmentVariable('ACT_ALLOWED_IP_RANGES', '[]'))
param publicWebUrl = readEnvironmentVariable('ACT_PUBLIC_WEB_URL', '')

// Set by the workflow per step (bootstrap, migrate, roll).
param imageTag = readEnvironmentVariable('ACT_IMAGE_TAG', 'replace-with-commit-sha')
param migrationImageTag = readEnvironmentVariable('ACT_MIGRATION_IMAGE_TAG', readEnvironmentVariable('ACT_IMAGE_TAG', 'replace-with-commit-sha'))
param deployApps = bool(readEnvironmentVariable('ACT_DEPLOY_APPS', 'true'))
param deployMigrationJob = bool(readEnvironmentVariable('ACT_DEPLOY_MIGRATION_JOB', 'true'))
// Empty except on first deploy or rotation; the workflow generates it.
param postgresAdminPassword = readEnvironmentVariable('ACT_POSTGRES_ADMIN_PASSWORD', '')
